<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <WrapPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button Click="Button_Click">Connect</Button>
            <Button Click="Button_Click_1">Disconnect</Button>
            <Button Click="Button_Click_2">Leggi stato</Button>
            <Button Tag="2;1|" Click="Button_Click_3">Riscaldatore ON</Button>
            <Button Tag="2;0|" Click="Button_Click_3">Riscaldatore OFF</Button>
            <Button Tag="3;1|" Click="Button_Click_3">CARICO_ACQUA ON</Button>
            <Button Tag="3;0|" Click="Button_Click_3">CARICO_ACQUA OFF</Button>
            <Button Tag="4;1|" Click="Button_Click_3">POMPA_PERISTALTICA ON</Button>
            <Button Tag="4;0|" Click="Button_Click_3">POMPA_PERISTALTICA OFF</Button>
            <Button Tag="5;1|" Click="Button_Click_3">AGITATORE ON</Button>
            <Button Tag="5;0|" Click="Button_Click_3">AGITATORE OFF</Button>
            <Button Tag="6;1|" Click="Button_Click_3">TENSIONE_SENSORE_1 ON</Button>
            <Button Tag="6;0|" Click="Button_Click_3">TENSIONE_SENSORE_1 OFF</Button>
            <Button Tag="7;1|" Click="Button_Click_3">TENSIONE_SENSORE_2 ON</Button>
            <Button Tag="7;0|" Click="Button_Click_3">TENSIONE_SENSORE_2 OFF</Button>
            <Button Tag="8;1|" Click="Button_Click_3">TENSIONE_SENSORE_3 ON</Button>
            <Button Tag="8;0|" Click="Button_Click_3">TENSIONE_SENSORE_3 OFF</Button>


        </WrapPanel>
        <TextBlock Name="T"></TextBlock>
    </DockPanel>
</Window>
